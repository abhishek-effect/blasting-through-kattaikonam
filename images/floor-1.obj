# floor-1.obj - First Floor Campus Blueprint Architecture
mtllib floor-1.mtl

# --- FLOORS & CEILINGS ---
usemtl white_tiles
# Main Floor
v 0 0 100
v 100 0 100
v 100 0 0
v 0 0 0
f -4 -3 -2 -1

usemtl black_solid
# Black Tiles Area
v 28 0.01 70
v 44 0.01 70
v 44 0.01 28
v 28 0.01 28
f -4 -3 -2 -1

usemtl ceiling
# Ceiling (Height = 5)
v 0 5 0
v 100 5 0
v 100 5 100
v 0 5 100
f -4 -3 -2 -1

# --- BOUNDARY WALLS ---
usemtl boundary_wall
# North Boundary
