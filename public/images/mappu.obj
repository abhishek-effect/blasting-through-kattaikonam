# map.obj - Geometry Definitions
mtllib map.mtl

# --- FLOORS & CEILINGS ---
usemtl white_tiles
# Main Floor
v 0 0 100
v 100 0 100
v 100 0 0
v 0 0 0
f -4 -3 -2 -1

usemtl black_solid
# Black Tiles Area (slightly raised to prevent flickering)
v 20 0.01 65
v 38 0.01 65
v 38 0.01 25
v 20 0.01 25
f -4 -3 -2 -1

usemtl ceiling
# Pure White Ceiling (Height = 5)
v 0 5 0
v 100 5 0
v 100 5 100
v 0 5 100
f -4 -3 -2 -1

# --- BOUNDARY WALLS (#fae6e7) ---
